":"import axios from 'axios';\nimport { showAlert } from './alerts';\n\nexport const updateSettings = async (data, type) => {\n  try {\n    const url =\n      type === 'password'\n        ? 'http://127.0.0.1:3000/api/users/updateMyPassword'\n        : 'http://127.0.0.1:3000/api/users/updateMe';\n\n    const res = await axios({\n      method: 'PATCH',\n      url,\n      data,\n    });\n\n    if (res.data.status === 'success') {\n      showAlert(\n        'success',\n        `${type === 'password' ? 'Password' : 'Data'} updated successfully!`,\n      );\n\n      return true;\n    }\n  } catch (err) {\n    showAlert('error', err.response?.data?.message || 'Something went wrong!');\n\n    return false;\n  }\n};\n"},"lineCount":null}},"error":null,"hash":"880417a9e94a0db0c736b67cdf939ac3","cacheData":{"env":{}}}